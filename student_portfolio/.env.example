# Copy this file to .env and edit.

# Local Docker:  redis://localhost:6379/0
# Redis Cloud:   rediss://default:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT
REDIS_URL=redis://localhost:6379/0

# Any long random string. Logins reset on restart if this is empty.
SECRET_KEY=change-me-to-a-long-random-string

# Admin account, created on first start
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=Admin@123

# 1 = load demo students the first time the app starts
AUTO_SEED=1

# Set to 1 when the site is served over HTTPS
COOKIE_SECURE=0

HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
